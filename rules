#!/usr/bin/make -f

export DH_VERBOSE=1

DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
include /usr/share/dpkg/architecture.mk

# This needed for cross-builds but breaks mpicc. Why? 2025-08-30
# DPKG_EXPORT_BUILDTOOLS = 1
# include /usr/share/dpkg/buildtools.mk

DESTDIR:=$(CURDIR)/debian/tmp/
BUILDDIR_FLANG=debian/build-flang
BUILDDIR_GFORTRAN=debian/build-gfortran
LIBDIR:=/usr/lib/$(DEB_HOST_MULTIARCH)
AUTOGENERATED:= libopenmpi-dev.postinst libopenmpi-dev.prerm

### Arch-specific stuff
# No ibverbs support available on kFreeBSD, Hurd
NO_VERBS_ARCH:= hurd-amd64 s390x 
NO_FABRIC_ARCH:=hurd-amd64 s390x 
PSM2_ARCH:= amd64
UCX_ARCH:= amd64 ppc64el arm64 riscv64 loong64
UCC_ARCH:= amd64 ppc64el arm64 riscv64
ATOMICS_ARCH:= s390x riscv64
NO_CMA_ARCH:= s390x alpha sparc64
NO_JAVA_ARCH:= hurd-amd64 ppc64 alpha sparc64
NO_TEST_ARCH:= hurd-amd64


UCX:=     $(if $(filter $(DEB_TARGET_ARCH), $(UCX_ARCH)),  --with-ucx,  )
UCC:=     $(if $(filter $(DEB_TARGET_ARCH), $(UCC_ARCH)),  --with-ucc,  )
VERBS:=   $(if $(filter $(DEB_TARGET_ARCH), $(NO_VERBS_ARCH)), , --with-verbs ) 
FABRIC:=  $(if $(filter $(DEB_TARGET_ARCH), $(NO_FABRIC_ARCH)),  , --with-libfabric  )
PSM2:=    $(if $(filter $(DEB_TARGET_ARCH), $(PSM2_ARCH)),  --with-psm2, )
ATOMICS:= $(if $(filter $(DEB_TARGET_ARCH), $(ATOMICS_ARCH)), --enable-builtin-atomics, )
CMA:=     $(if $(filter $(DEB_TARGET_ARCH), $(NO_CMA_ARCH)), --without-cma , )
DO_TEST:= $(if $(filter $(DEB_TARGET_ARCH), $(NO_TEST_ARCH)), false, true)
BTL_TESTS:= $(if $(DO_TEST), --enable-opal-btl-usnic-unit-tests, )
# DO_FLANG:=$(if $(wildcard /usr/bin/flang),true, false)
DO_FLANG:=false

ifeq ($(filter nojava,$(DEB_BUILD_PROFILES)),)
       JAVA := $(if $(filter $(DEB_TARGET_ARCH), $(NO_JAVA_ARCH)), \
		 ,--with-jdk-dir=/usr/lib/jvm/default-java --enable-mpi-java )
endif

FLANG_FCFLAGS= $(filter '-g', $(shell dpkg-buildflags --get FCFLAGS))
FLANG_LIBDIR= $(LIBDIR)/fortran/flang

FLANG_VERSION=$(shell basename $(shell readlink /usr/bin/flang))

FMODDIR:=$(shell dh_fortran get_fmoddir)
# arch-neutral version we can put in openmpi-common configs
FMODDIR_STRING:="$(FMODDIR)"

# Drop '-g' flag with flang. Known failure with 2018122 version
ifneq ($(filter flang,$(FC)),)
FCFLAGS=$(shell dpkg-buildflags --get FCLAGS |  sed -e 's/-g //')
endif


ifeq (sparc,$(DEB_HOST_GNU_CPU))
	CFLAGS += -mcpu=v9
endif

# Use -O3 recommended by upstream
CFLAGS += -O3 -I$(LIBDIR)/pmix2/include/pmix
CXXFLAGS += -O3 -I$(LIBDIR)/pmix2/include/pmix
FCFLAGS += -O3

# Flags for the static build: see bug #502232
#STATIC_CONFIG_PARAMS = --enable-static
STATIC_CONFIG_PARAMS =  

# Do not embed build username or build system hostname, see README
export HOSTNAME=hostname
export USER=username

%:
	dh $@ --with sphinxdoc

extra_flags = \
		--disable-silent-rules \
		--disable-wrapper-runpath \
		--disable-wrapper-rpath \
		--with-package-string="Debian OpenMPI" \
		$(VERBS) $(FABRIC) $(PSM2) $(CMA) \
		$(UCX) \
		$(UCC) \
		$(ATOMICS) \
		$(JAVA) \
		$(STATIC_CONFIG_PARAMS) \
		$(BTL_TESTS) \
		--with-pmix=$(LIBDIR)/pmix2 \
		--with-prrte=/usr \
                --with-libevent=external \
		--with-hwloc=external  \
		--disable-silent-rules \
		--enable-ipv6  \
		--with-devel-headers \
		--with-slurm \
		--with-sge \
		--without-tm \
		--sysconfdir=/etc/openmpi 		\
		--libdir=\$${prefix}/lib/${DEB_HOST_MULTIARCH}/openmpi/lib	\
		--includedir=\$${prefix}/lib/${DEB_HOST_MULTIARCH}/openmpi/include 

override_dh_auto_clean:
	dh_clean
	rm -fr debian/build-* docs/_build 3rd-party/pympistandard/*
	rm -rf contrib/dist/mofed/debian
	rm -f $(patsubst %, debian/%, ${AUTOGENERATED})
	find . -name Makefile.in -delete
	find . -name .buildinfo -delete
	find . -name .libs -exec rm -rf {} \; || true
	find . -name .dirstamp -delete
	# find . -type l -delete
	find . -name '*.o' -delete
	find . -name '*.l[ao]' -delete
	find . -name '*.class' -delete
	find . -name 'Makefile' -delete

override_dh_update_autotools_config:
	cp -a debian/source/mofed/debian contrib/dist/mofed
	(cd config && autom4te --language=m4sh opal_get_version.m4sh -o opal_get_version.sh)
	tar -C 3rd-party -axpf debian/pympistandard.tar.gz 
	./autogen.pl --force  --no-3rdparty pmix,prrte

override_dh_autoreconf:
	@echo Skipping extra autoreconf.

execute_before_dh_auto_configure:
	for f in ${AUTOGENERATED} ; do \
               sed -e 's%@DEB_HOST_MULTIARCH@%${DEB_HOST_MULTIARCH}%g' < debian/$$f.in  > debian/$$f ; \
               done

override_dh_auto_configure:
	dh_auto_configure --builddirectory=$(BUILDDIR_GFORTRAN) -- $(extra_flags)

override_dh_auto_build:
	dh_auto_build --builddirectory=$(BUILDDIR_GFORTRAN)	

override_dh_install:
	# VERSION used by sphinx
	( mkdir -p 3rd-party/openpmix && echo "7.0.0" > 3rd-party/openpmix/VERSION )
	dh_auto_install --builddirectory=$(BUILDDIR_GFORTRAN)
	$(DO_FLANG) && find $(BUILDDIR_FLANG) -type f -perm -+x -a ! -name '*.la' -a ! -name '*.mod' -exec chrpath -d '{}' \; || true
# Rename the compiler and startup wrappers.
	for f in mpic++ mpicc mpiCC mpicxx mpiexec mpif77 mpif90 mpirun mpifort ; do \
		if test -f $(DESTDIR)/usr/bin/$${f}; then \
			mv $(DESTDIR)/usr/bin/$${f} $(DESTDIR)/usr/bin/$${f}.openmpi ; \
		fi; \
	done
	# Rename some files
	# Ensure correct mpiexec is used
	rm $(DESTDIR)/usr/bin/mpiexec.openmpi $(DESTDIR)/usr/bin/oshrun
	ln -s mpirun.openmpi $(DESTDIR)/usr/bin/mpiexec.openmpi
	ln -s mpirun.openmpi $(DESTDIR)/usr/bin/oshrun
	# New API
	mv $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_abi.so.1.0.0 $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_abi_openmpi.so.1.0.0
# Strip rpath from pc,wrapper files
	# TODO Fix FMODDIR For different compilers
	for f in ompi-c.pc  ompi-cxx.pc  ompi-f77.pc  ompi-f90.pc  ompi-fort.pc  ompi.pc  opal.pc  oshmem-c.pc  oshmem-cxx.pc  oshmem-fort.pc  oshmem.pc ; do  \
		sed -e 's/-Wl,-rpath -Wl,$${libdir}//' < $(DESTDIR)/$(LIBDIR)/openmpi/lib/pkgconfig/$${f} | \
                sed -e 's%@FMODDIR@%$${FMODDIR}%g' > debian/tmp.x ; \
		mv debian/tmp.x $(DESTDIR)/$(LIBDIR)/openmpi/lib/pkgconfig/$${f} ; \
		done
	find . -name '*wrapper-data.txt' | while read f; do \
		sed -e 's%$${prefix}/lib/${DEB_HOST_MULTIARCH}%$${libdir}%g' <  $$f | \
		sed -e 's/-Wl,-rpath -Wl,$${libdir}//' | \
		sed -e 's%@FMODDIR@%${FMODDIR_STRING}%g' | \
		sed -e 's/^compiler=gfortran-[0-9][0-9]*$$/compiler=gfortran/' > debian/tmp.x ; \
		mv debian/tmp.x $$f ; done
# Rename the compiler wrapper man pages.
	for f in mpic++ mpicc mpicxx mpiexec mpif77 mpif90 mpirun mpifort ; do \
		if test -f $(DESTDIR)/usr/share/man/man1/$${f}.1; then \
			mv $(DESTDIR)/usr/share/man/man1/$${f}.1 $(DESTDIR)/usr/share/man/man1/$${f}.openmpi.1 ; \
		fi; \
		if test -f $(DESTDIR)/usr/share/man/man1/$${f}.3; then \
			mv $(DESTDIR)/usr/share/man/man3/$${f}.3 $(DESTDIR)/usr/share/man/man1/$${f}.openmpi.3 ; \
		fi; \
	done
	cd $(DESTDIR)/usr/share/man/man3; \
	for f in *.3; do \
		mv $$f $$(echo $$f|sed -e "s|\.3|.openmpi.3|g"); \
	done; \
	mkdir -p $(DESTDIR)/$(LIBDIR)/openmpi/lib/
	cp $(BUILDDIR_GFORTRAN)/ompi/mpi/fortran/*/.libs/libmpi_mpifh.so.40.50.0  $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_mpifh.so.40.50.0
	cp $(BUILDDIR_GFORTRAN)/ompi/mpi/fortran/*/.libs/libmpi_usempi_ignore_tkr.so.40.50.0 $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_usempi_ignore_tkr.so.40.50.0
	cp $(BUILDDIR_GFORTRAN)/ompi/mpi/fortran/*/.libs/libmpi_usempif08.so.40.50.0 $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_usempif08.so.40.50.0
	ld -shared -fPIC -z noexecstack -soname libmpi_mpifh-gfortran.so.40 -o $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_mpifh-gfortran.so.40.50.0 \
               $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_mpifh.so.40.50.0
	ld -shared -fPIC  -z noexecstack -soname libmpi_usempi_ignore_tkr-gfortran.so.40 \
		-o $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_usempi_ignore_tkr-gfortran.so.40.50.0 \
		   $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_usempi_ignore_tkr.so.40.50.0
	ld -shared -fPIC -z noexecstack -soname libmpi_usempif08-gfortran.so.40 -o $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_usempif08-gfortran.so.40.50.0 \
		$(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_usempif08.so.40.50.0
	dh_fortran_mod -p libopenmpi-dev  $(BUILDDIR_GFORTRAN)/ompi/mpi/fortran/mpiext/*.mod openmpi
	# Flang, if present
	$(DO_FLANG) && ( \
		mkdir -p $(DESTDIR)/$(FLANG_MODDIR) ; \
		dh_fortran_mod -p libopenmpi-dev  $(BUILDDIR_FLANG)/ompi/mpi/fortran/mpiext/*.mod openmpi ; \
		dh_fortran_mod -p libopenmpi-dev  $(BUILDDIR_FLANG)/ompi/mpi/fortran/use-mpi-ignore-tkr/*.mod openmpi ; \
		dh_fortran_mod -p libopenmpi-dev  $(BUILDDIR_FLANG)/ompi/mpi/fortran/use-mpi-f08/*.mod openmpi ; \
		dh_fortran_mod -p libopenmpi-dev  $(BUILDDIR_FLANG)/ompi/mpi/fortran/use-mpi-f08/mod/*.mod openmpi ; \
		dh_fortran_mod -p libopenmpi-dev  $(BUILDDIR_FLANG)/ompi/mpi/fortran/mpiext-use-mpi/*.mod openmpi ; \
		cp $(BUILDDIR_FLANG)/ompi/mpi/fortran/*/.libs/libmpi_mpifh.so.40.50.0 $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_mpifh-flang.so.40.50.0; \
		cp $(BUILDDIR_FLANG)/ompi/mpi/fortran/*/.libs/libmpi_usempi_ignore_tkr.so.40.50.0 $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_usempi_ignore_tkr-flang.so.40.50.0 ; \
		cp $(BUILDDIR_FLANG)/ompi/mpi/fortran/*/.libs/libmpi_usempif08.so.40.50.0 $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_usempif08-flang.so.40.50.0 ; \
		dh_link -p libopenmpi40 $(LIBDIR)/libmpi_mpifh-flang.so.40.50.0           $(LIBDIR)/openmpi/lib/libmpi_mpifh-flang.so.40 ; \
		dh_link -p libopenmpi-dev $(LIBDIR)/libmpi_mpifh-flang.so.40.50.0   $(FLANG_LIBDIR)/openmpi/lib/libmpi_mpifh-flang.so ; \
		dh_link -p libopenmpi40 $(LIBDIR)/libmpi_usempif08-flang.so.40.50.0           $(LIBDIR)/openmpi/lib/libmpi_usempif08-flang.so.40   ; \
		dh_link -p libopenmpi-dev $(LIBDIR)/libmpi_usempif08-flang.so.40.50.0   $(FLANG_LIBDIR)/openmpi/lib/libmpi_usempif08.so ; \
		dh_link -p libopenmpi40 $(LIBDIR)/libmpi_usempi_ignore_tkr-flang.so.40.50.0          $(LIBDIR)/openmpi/lib/libmpi_usempi_ignore_tkr-flang.so.40 ; \
		dh_link -p libopenmpi-dev $(LIBDIR)/libmpi_usempi_ignore_tkr-flang.so.40.50.0   $(FLANG_LIBDIR)/openmpi/lib/libmpi_usempi_ignore_tkr.so ; \
		) || true
#		patchelf  --set-soname libmpi_mpifh-flang.so.40 $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_mpifh-flang.so.40.50.0 ; \
#		patchelf  --set-soname libmpi_usempi_ignore_tkr-flang.so.40 $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_usempi_ignore_tkr-flang.so.40.50.0 ; \
#		patchelf  --set-soname libmpi_usempif08-flang.so.40 $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_usempif08-flang.so.40.50.0 ; \
	# Strip rpath info from all executables and libraries.
	find $(DESTDIR) -type f -perm -+x -a ! -name '*.la' -a ! -name '*.mod' -exec chrpath -d '{}' \; || true
# Rename orte-bootproxy.sh to orte-bootproxy
	if test -f $(DESTDIR)/usr/bin/orte-bootproxy.sh; then \
		mv $(DESTDIR)/usr/bin/orte-bootproxy.sh $(DESTDIR)/usr/bin/orte-bootproxy; \
	fi
# Remove dangling symlink(s)
	rm -f $(DESTDIR)/usr/share/man/man1/mpiCC.1
	rm -f $(DESTDIR)/usr/share/man/man1/orteCC.1
# Remove COPYRIGHT file of ptmalloc2. It's reproduced in debian/copyright.
	rm -fr $(DESTDIR)/usr/share/openmpi/doc/
# Remove pmi2, pmix now in separate package
	rm -rf $(DESTDIR)/usr/lib/*/openmpi/include/pmi*
# Remove buggy ${pkgincludedir} refs from pkg-config files. #837062
	find . -name '*.pc' -type f | while read f ; do \
		cat $${f} | sed -e 's%-I$${pkgincludedir}[a-zA-Z0-9/]* %%g' > x ; \
		 mv x $${f}; done
# sanitize build paths for bit-reproducibility
	if test $(DESTDIR)/${LIBDIR}/openmpi/include/openmpi/opal_config.h ; then \
		sed -e 's%${CURDIR}%/build/openmpi%g' < $(DESTDIR)/${LIBDIR}/openmpi/include/openmpi/opal_config.h \
			> $(DESTDIR)/x ; \
		mv $(DESTDIR)/x /$(DESTDIR)/${LIBDIR}/openmpi/include/openmpi/opal_config.h ; \
	fi
# Continue as usual
	dh_install
# oshmem, shmem only built on Linux so do by hand or it may fail ...
	if test -f $(DESTDIR)/usr/bin/oshmem_info ; then \
		dh_link -p openmpi-bin 	/usr/bin/mpirun.openmpi /usr/bin/oshrun ;\
		dh_install -p openmpi-bin  /usr/bin/oshmem_info ; \
		dh_install -p openmpi-bin  /usr/bin/oshcxx ;\
		dh_install -p openmpi-bin  /usr/bin/oshcc ;\
		dh_install -p openmpi-bin  /usr/bin/oshc++ ;\
		dh_install -p openmpi-bin  /usr/bin/oshfort     ; \
		dh_install -p openmpi-bin  /usr/bin/oshCC ; \
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/oshfort.1 ; \
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/oshrun.1 ; \
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/oshmem_info.1 ; \
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/oshcc.1 ; \
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/oshCC.1 ; \
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/oshc++.1 ; \
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/oshcxx.1 ; \
		dh_install -p libopenmpi40 $(LIBDIR)/openmpi/lib/liboshmem.so.40.50.0 $(LIBDIR) ; \
                dh_link -p libopenmpi40 $(LIBDIR)/liboshmem.so.40.50.0  $(LIBDIR)/liboshmem.so.40 ; \
		dh_link -p libopenmpi-dev   $(LIBDIR)/liboshmem.so.40  $(LIBDIR)/openmpi/lib/liboshmem.so ; \
		dh_link -p libopenmpi-dev   $(LIBDIR)/liboshmem.so.40  $(LIBDIR)/liboshmem.so ; \
		dh_link -p libopenmpi-dev   usr/bin/oshmem_info $(LIBDIR)/openmpi/bin/oshmem_info; \
		dh_link -p libopenmpi-dev   usr/bin/oshcc $(LIBDIR)/openmpi/bin/oshcc ; \
		dh_link -p libopenmpi-dev   usr/bin/oshc++ $(LIBDIR)/openmpi/bin/oshc++ ; \
		dh_link -p libopenmpi-dev   usr/bin/oshcxx $(LIBDIR)/openmpi/bin/oshcxx ; \
		dh_link -p libopenmpi-dev   usr/bin/oshCC $(LIBDIR)/openmpi/bin/oshCC ; \
		dh_link -p libopenmpi-dev   usr/bin/oshfort $(LIBDIR)/openmpi/bin/oshfort ; \
	fi
	if test -f $(DESTDIR)/$(LIBDIR)/openmpi/lib/libmpi_java.so.40.50.0 ; then \
		dh_install -p openmpi-bin /usr/bin/mpijavac ; \
		dh_install -p openmpi-bin usr/bin/mpijavac.pl ; \
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/mpijavac.1 ; \
		dh_install -p libopenmpi40 $(LIBDIR)/openmpi/lib/libmpi_java.so.40.50.0 $(LIBDIR); \
		dh_link -p libopenmpi40 $(LIBDIR)/libmpi_java.so.40.50.0  $(LIBDIR)/libmpi_java.so.40 ; \
		dh_link -p libopenmpi-dev $(LIBDIR)/libmpi_java.so.40	$(LIBDIR)/openmpi/lib/libmpi_java.so ; \
		dh_link -p libopenmpi-dev $(LIBDIR)/libmpi_java.so.40	$(LIBDIR)/libmpi_java.so ; \
		dh_link -p libopenmpi-dev   usr/bin/mpijavac $(LIBDIR)/openmpi/bin/mpijavac; \
		dh_link -p libopenmpi-dev   usr/bin/mpijavac.pl $(LIBDIR)/openmpi/bin/mpijavac.pl ; \
	fi
	# If shmemrun exists, its a broken link so use -h to test
	if test -h $(DESTDIR)/usr/bin/shmemrun ; then \
		dh_link -p  openmpi-bin   /usr/bin/mpirun.openmpi  /usr/bin/shmemrun ;\
		dh_install -p openmpi-bin usr/bin/shmemcc ; \
		dh_install -p openmpi-bin usr/bin/shmemcxx ; \
		dh_install -p openmpi-bin usr/bin/shmemc++ ; \
		dh_install -p openmpi-bin /usr/bin/shmemCC ; \
		dh_install -p openmpi-bin /usr/bin/shmemfort ; \
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/shmemcc.1 ;\
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/shmemc++.1 ;\
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/shmemfort.1 ; \
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/shmemrun.1 ; \
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/shmemCC.1 ; \
		dh_installman -p openmpi-bin $(DESTDIR)/usr/share/man/man1/shmemcxx.1 ; \
	fi


override_dh_fixperms-arch:
	-chmod 0644 debian/libopenmpi-dev/usr/lib/*/fortran/*/openmpi/*.mod
	rm -f debian/libopenmpi-dev/usr/lib/*/openmpi/lib/ompi_monitoring_prof.so
	find debian/libopenmpi40 -name 'lib*.so*' -exec chrpath -d {} \;
	find debian/openmpi-bin/usr/bin -exec chrpath -d {} \;
	dh_fixperms

override_dh_auto_test:
	$(DO_TEST) && dh_auto_test || echo "Tests disabled on ${NO_TEST_ARCH} systems for the moment"	

override_dh_shlibdeps:
	dh_shlibdeps -l$(DESTDIR)/$(LIBDIR)/openmpi/lib -- --ignore-missing-info

override_dh_sphinxdoc:
	dh_sphinxdoc -X doctools.js -X searchtools.js

override_dh_installdocs-indep:
	dh_installdocs --all README.md
	# dh_installman -p openmpi-doc $(DESTDIR)/usr/share/man/man7/*
	# dh_installman -p openmpi-doc $(DESTDIR)/usr/share/man/man3/*
ifeq ($(filter nojava,$(DEB_BUILD_PROFILES)),)
	mkdir -p debian/tmp/usr/share/doc/libopenmpi-dev
	mv debian/tmp/usr/share/doc/openmpi/javadoc-openmpi debian/tmp/usr/share/doc/libopenmpi-dev/javadoc-openmpi
	dh_installdocs -p openmpi-doc --doc-main-package libopenmpi-dev  debian/tmp/usr/share/doc/libopenmpi-dev/javadoc-openmpi
endif
	# for f in doctools.js searchtools.js ; do \
		#rm -d debian/openmpi-doc/usr/share/doc/openmpi-doc/html/_static/$$f ; \
		#ln -s  /usr/share/javascript/sphinxdoc/1.0/$$f debian/openmpi-doc/usr/share/doc/openmpi-doc/html/_static/$$f ; \
		#done
	rm -f debian/openmpi-doc/usr/share/doc/libopenmpi-dev/javadoc-openmpi/script-files/jquery-ui.min.js \
		debian/openmpi-doc/usr/share/doc/libopenmpi-dev/javadoc-openmpi/script-files/jquery-3.7.1.min.js \
		debian/openmpi-doc/usr/share/doc/libopenmpi-dev/javadoc-openmpi/resource-files/jquery-ui.min.css
	ln -s /usr/share/javascript/jquery/jquery.min.js debian/openmpi-doc/usr/share/doc/libopenmpi-dev/javadoc-openmpi/script-files/jquery-3.7.1.min.js
	for f in jquery-ui.min.css jquery-ui.min.js ; do \
		rm -f debian/openmpi-doc/usr/share/doc/libopenmpi-dev/javadoc-openmpi/script-files/$$f ; \
		done
	ln -s /usr/share/javascript/jquery-ui/jquery-ui.min.js debian/openmpi-doc/usr/share/doc/libopenmpi-dev/javadoc-openmpi/script-files/jquery-ui.min.js
	ln -s /usr/share/javascript/jquery-ui/themes/base/jquery-ui.min.css debian/openmpi-doc/usr/share/doc/libopenmpi-dev/javadoc-openmpi/script-files/jquery-ui.min.css
